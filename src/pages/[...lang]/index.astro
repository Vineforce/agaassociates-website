---
import Base from "@/layouts/Base.astro";
import { getEntryCTM } from "@/lib/contentParser.astro";
import { generatePaths } from "@/lib/utils/i18nUtils.ts";
import TeamSection from "@/components/sections/TeamSection.astro";
import BlogSection from "@/components/sections/BlogSection.astro";
import BannerThree from "@/components/sections/BannerThree.astro";
import FeatureCardsSection from "@/components/sections/FeatureCardsSection.astro";
import ServicesOverviewSection from "@/components/sections/ServicesOverviewSection.astro";

export function getStaticPaths() {
  return generatePaths();
}

const homepageContent = await getEntryCTM(
  "homepage",
  "-index",
  Astro.currentLocale,
);
---

<Base {...homepageContent?.data} headerLayout="two" headerPosition="sticky">
  <BannerThree />
  <FeatureCardsSection />
  <ServicesOverviewSection />
  <TeamSection content={{ options: { limit: 4 } }} />
  <BlogSection />
</Base>
