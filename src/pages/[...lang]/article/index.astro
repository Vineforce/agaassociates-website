---
import Base from "@/layouts/Base.astro";
import { getCollectionCTM } from "@/lib/contentParser.astro";
import { generatePaths } from "@/lib/utils/i18nUtils.ts";
import BlogCard from "@/components/cards/BlogCard.astro";

import Pagination from "@/components/widgets/Pagination.astro";

export function getStaticPaths() {
  return generatePaths();
}

const rawPosts = await getCollectionCTM("blog", Astro.currentLocale);
const posts = rawPosts.sort((a, b) => {
  const dateA = a.data.date ? new Date(a.data.date).getTime() : 0;
  const dateB = b.data.date ? new Date(b.data.date).getTime() : 0;
  return dateB - dateA;
});

const pageSize = 3;
const totalPages = Math.max(2, Math.ceil(posts.length / pageSize));

const pageMeta = {
  title: "Article",
  description: "Read our latest articles on accounting, taxation, auditing, and corporate compliance.",
};
---

<Base {...pageMeta} headerLayout="two" headerPosition="sticky">
  <section class="py-10 md:py-14 bg-slate-50/50 min-h-[75vh]">
    <div class="container mx-auto px-4 md:px-6">
      {/* Top Right Breadcrumb Bar */}
      <div class="flex items-center justify-end text-xs sm:text-sm text-slate-500 font-medium pb-4 mb-8 border-b border-slate-200/60">
        <nav class="flex items-center gap-1.5 flex-wrap justify-end" aria-label="Breadcrumb">
          <a href="/" class="text-[#61CE70] hover:underline font-medium">Home</a>
          <span class="text-slate-400">&gt;</span>
          <span class="text-slate-700 font-semibold">Article</span>
        </nav>
      </div>

      {/* 3 Articles Grid */}
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
        {
          posts?.slice(0, 3).map((post) => (
            <div data-scroll-reveal="fade-up">
              <BlogCard content={post} options={{ layout: "grid" }} />
            </div>
          ))
        }
      </div>

      {/* Dynamic Theme Pagination Bar */}
      <Pagination collection="article" currentPage={1} totalPages={totalPages} />
    </div>
  </section>
</Base>
