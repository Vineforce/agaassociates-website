---
import Base from "@/layouts/Base.astro";
import { generatePaths } from "@/lib/utils/i18nUtils.ts";
import ContentList from "@/components/widgets/ContentList.astro";
import PageHeader from "@/components/widgets/PageHeader.astro";

export function getStaticPaths() {
  return generatePaths();
}

const pageMeta = {
  title: "Articles, Insights & News",
  heroDescription: "Stay informed with our latest regulatory updates, statutory tax advisories, corporate compliance guides, and financial insights from HAVN & Company.",
  description: "Read our latest articles on accounting, taxation, auditing, and corporate compliance.",
};
---

<Base {...pageMeta} headerLayout="two" headerPosition="sticky">
  <PageHeader content={pageMeta} />
  <section class="py-10 md:py-14 bg-slate-50/50 min-h-[75vh]">
    <div class="container mx-auto px-4 md:px-6">
      <ContentList
        options={{
          layout: "grid",
          columns: 3,
        }}
        pagination={{
          enable: true,
          currentPage: 1,
        }}
      />
    </div>
  </section>
</Base>
