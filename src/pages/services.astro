---
import Base from "@/layouts/Base.astro";
import ServiceHero from "@/components/bodyTemplates/ServiceHero.astro";
import ServicesOverviewSection from "@/components/sections/ServicesOverviewSection.astro";

const servicesPageHero = {
  title: "Services",
  category: "Overview",
  heroDescription: "Comprehensive accounting, auditing, taxation, and business consultancy services tailored to empower your business with legal compliance and growth.",
  heroImage: "/src/assets/images/serviceSection/register-service/team-work-process-young-business-managers-crew-working-with-new-startup-project-labtop-wood-table-typing-keyboard-texting-message-analy.jpg",
  images: [
    "/src/assets/images/serviceSection/register-service/team-work-process-young-business-managers-crew-working-with-new-startup-project-labtop-wood-table-typing-keyboard-texting-message-analy.jpg",
    "/src/assets/images/serviceSection/register-service/business-man-financial-inspector-secretary-making-report-calculating-checking-balance-internal-revenue-service-inspector-checking-document-audit-concept-sca.jpg",
  ],
};
---

<Base title="Our Services" description={servicesPageHero.heroDescription} fitToScreen={false}>
  <ServiceHero service={servicesPageHero} />
  <ServicesOverviewSection />
</Base>
