---
import Logo from "@/components/global/Logo.astro";
import HeaderOffcanvasContent from "@/components/widgets/HeaderOffcanvasContent.astro";
import Offcanvas from "../../widgets/Offcanvas.astro";
import NavbarToggler from "@/layouts/components/global/header/NavbarToggler.astro";
import Navbar from "./Navbar.astro";
import Topbar from "./Topbar.astro";
import Icons from "@/helpers/Icons.astro";
import { useTranslations } from "@/lib/utils/i18nUtils.ts";
import config from ".astro/config.generated.json";
import type { HeaderLayout } from "@/types";

const t = await useTranslations(Astro.currentLocale as string);

type TopbarContent = "location" | "office-hours";
type HeaderLayoutConfig = {
  topbarLayout: "light" | "navy";
  topbarLeftContent: TopbarContent[];
  topbarSize?: "default" | "compact";
  hasDarkAppearance: boolean;
  isTransparent?: boolean;
  isMenuRight: boolean;
  navbarClass?: string;
};

const {
  settings: { stickyHeader, navigationButton: navBtnConfig, headerOffcanvas },
} = config;

const {
  layout = "two",
  headerLayout,
  hideOffcanvas,
  position,
  navigationButton: customNavigationButton = navBtnConfig,
  class: ClassName,
} = Astro.props as {
  layout?: HeaderLayout | string;
  headerLayout?: HeaderLayout | string;
  position?: "fixed" | "static" | "sticky";
  hideOffcanvas?: boolean;
  navigationButton?: typeof navBtnConfig;
  class?: string;
};

const layoutConfig: Record<HeaderLayout, HeaderLayoutConfig> = {
  two: {
    topbarLayout: "light",
    topbarLeftContent: ["location"],
    hasDarkAppearance: false,
    isTransparent: false,
    isMenuRight: false,
    navbarClass: "mx-auto",
  },
  three: {
    topbarLayout: "light",
    topbarLeftContent: ["location"],
    topbarSize: "compact",
    hasDarkAppearance: false,
    isTransparent: false,
    isMenuRight: true,
    navbarClass: "lg:pe-5",
  },
};

const isAvailableLayout = (
  value: HeaderLayout | string | undefined,
): value is keyof typeof layoutConfig =>
  typeof value === "string" && value in layoutConfig;

const resolvedLayout = isAvailableLayout(headerLayout)
  ? headerLayout
  : isAvailableLayout(layout)
    ? layout
    : "two";
const currentLayout = layoutConfig[resolvedLayout];

const navigationButton = { ...navBtnConfig, ...customNavigationButton };
---

<div
  class:list={[
    "site-header-wrap",
    { "has-sticky-behavior": stickyHeader },
    { fixed: position === "fixed" },
  ]}>
  <Topbar
    class="topbar"
    layout={currentLayout.topbarLayout}
    leftContent={currentLayout.topbarLeftContent}
    size={currentLayout.topbarSize}
  />

  <header
    class:list={[
      "header group/header bg-white border-b border-slate-100 shadow-xs",
      `header-${resolvedLayout}`,
      ClassName,
    ]}>
    <nav class="relative container">
      <div class="hs-dropdown relative flex items-center justify-between py-2 sm:py-3 lg:py-4">
        <Logo class="max-w-[200px] sm:max-w-[260px]" />

        <Navbar
          navigationButton={navigationButton}
          class:list={[
            currentLayout.isMenuRight && "navbar-right",
            currentLayout.navbarClass,
            "lg:pe-4",
          ]}
        />

        <div class="flex items-center gap-2 ms-2 sm:ms-4">
          <!-- Animated Expandable Search Area -->
          <div class="relative w-10 h-10 shrink-0 flex items-center justify-end" id="header-search-area">
            <div
              id="header-search-bar"
              class="absolute right-0 top-0 z-20 flex items-center h-10 w-10 overflow-hidden rounded-full bg-slate-100/90 border border-slate-200/60 transition-all duration-300 ease-in-out shadow-xs">
              <button
                id="header-search-trigger"
                type="button"
                aria-label="Search"
                class="flex h-10 w-10 shrink-0 items-center justify-center text-slate-700 hover:text-emerald-600 transition-colors cursor-pointer z-10">
                <Icons icon="Search" class="size-5 pointer-events-none" />
              </button>
              <input
                id="header-search-field"
                type="search"
                placeholder="Search..."
                class="w-full bg-transparent py-2 text-sm text-slate-800 placeholder:text-slate-400 focus:outline-none border-none ring-0 focus:ring-0 opacity-0 pointer-events-none transition-opacity duration-200"
                autocomplete="off"
              />
              <button
                id="header-search-clear"
                type="button"
                aria-label="Clear Search"
                class="hidden shrink-0 pr-3 text-slate-400 hover:text-slate-600 cursor-pointer z-10">
                <Icons icon="X" class="size-4 pointer-events-none" />
              </button>
            </div>

            <!-- Pagefind Search Results Dropdown Panel -->
            <div
              id="header-search-dropdown"
              data-lenis-prevent=""
              class="hidden absolute right-0 top-full mt-2.5 w-[280px] sm:w-[320px] max-h-[400px] overflow-y-auto overscroll-contain bg-white rounded-2xl shadow-2xl border border-slate-100 p-3 z-50">
              <div id="header-search-results" class="divide-y divide-slate-100"></div>
            </div>
          </div>

          <!-- Mobile Navbar Toggler -->
          {
            headerOffcanvas?.enable && (
              <NavbarToggler
                title={t("aria.openSidebarContent")}
                appearance="dark"
                isOffcanvasToggler={true}
                class:list={["rounded-md", "lg:hidden"]}
                aria-haspopup="dialog"
                aria-expanded="false"
                aria-controls="offcanvas-main"
                data-hs-overlay="#offcanvas-main"
                data-hs-overlay-options='{"emulateScrollbarSpace": true}'
              />
            )
          }
        </div>
      </div>
    </nav>
  </header>
</div>

{
  headerOffcanvas?.enable && (
    <Offcanvas
      class={hideOffcanvas ? "lg:hidden" : ""}
      id="offcanvas-main"
      direction="right"
      size="md"
      showDefault={false}>
      <HeaderOffcanvasContent
        offcanvas={"offcanvas-main"}
        navigationButton={navigationButton}
      />
    </Offcanvas>
  )
}

<style is:global>
  /* Remove native browser input[type="search"] clear button */
  #header-search-field::-webkit-search-cancel-button,
  #header-search-field::-webkit-search-decoration,
  #header-search-field::-webkit-search-results-button,
  #header-search-field::-webkit-search-results-decoration {
    -webkit-appearance: none;
    appearance: none;
    display: none;
  }

  /* Animated Search Bar Overlay */
  #header-search-bar {
    width: 2.5rem; /* 40px */
    transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1), background-color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }
  #header-search-bar.is-expanded {
    width: 10.5rem; /* 168px */
    background-color: #ffffff;
    border-color: #10b981;
    box-shadow: none;
  }
  @media (min-width: 640px) {
    #header-search-bar.is-expanded {
      width: 12.5rem; /* 200px */
    }
  }

  /* Pagefind Search Result Snippet Highlighting */
  #header-search-results mark {
    background-color: #d1fae5;
    color: #065f46;
    border-radius: 0.25rem;
    padding: 0 0.2rem;
    font-weight: 600;
  }
</style>

<script>
  function stickyHeader(): void {
    const header = document.querySelector(
      ".site-header-wrap.has-sticky-behavior",
    ) as HTMLElement | null;
    if (!header) return;

    let prevScrollPos = window.scrollY;
    const startStickyAt = 0;
    const hideTopbarAt = 100;
    const minScrollDiff = 50;

    const handleScroll = (initial = false) => {
      const currentScrollPos = window.scrollY;
      const scrollDiff = Math.abs(currentScrollPos - prevScrollPos);
      header.classList.toggle(
        "is-topbar-hidden",
        currentScrollPos > hideTopbarAt,
      );

      if (currentScrollPos === 0) {
        header.classList.remove("scroll-up", "scroll-down", "is-topbar-hidden");
        prevScrollPos = currentScrollPos;
        return;
      }

      if (currentScrollPos > startStickyAt) {
        if (initial || scrollDiff >= minScrollDiff) {
          if (currentScrollPos > prevScrollPos) {
            header.classList.remove("scroll-up");
            header.classList.add("scroll-down");
          } else {
            header.classList.remove("scroll-down");
            header.classList.add("scroll-up");
          }

          prevScrollPos = currentScrollPos;
        }
      }
    };

    window.addEventListener("scroll", () => handleScroll());
    handleScroll(true);
  }

  function initDropdownToggleAndClose(): void {
    const isMobile = () => window.innerWidth < 1024;

    document
      .querySelectorAll<HTMLAnchorElement>('a[href="#"], a[href="javascript:void(0)"]')
      .forEach((link) => {
        link.addEventListener("click", (e) => {
          e.preventDefault();
        });
      });

    const toggles = document.querySelectorAll<HTMLElement>(".hs-dropdown-toggle, .nav-dropdown-toggle");
    toggles.forEach((toggle) => {
      toggle.addEventListener("click", (e) => {
        const hasChildren = toggle.dataset.hasChildren === "true" || toggle.classList.contains("hs-dropdown-toggle");
        const href = (toggle as HTMLAnchorElement).getAttribute?.("href");
        const isDummy = !href || href === "#" || href === "javascript:void(0)";

        if (isMobile() && hasChildren) {
          e.preventDefault();
          e.stopImmediatePropagation();

          const parentDropdown = toggle.closest(".nav-dropdown");
          if (parentDropdown) {
            const list =
              parentDropdown.querySelector<HTMLElement>(":scope > .nav-dropdown-list") ||
              parentDropdown.querySelector<HTMLElement>(".nav-dropdown-list");
            const isCurrentlyOpen =
              parentDropdown.classList.contains("open") ||
              parentDropdown.classList.contains("hs-dropdown-open");

            if (isCurrentlyOpen) {
              parentDropdown.classList.remove("open", "hs-dropdown-open");
              if (list) {
                list.style.display = "none";
                list.style.removeProperty("opacity");
                list.style.removeProperty("visibility");
              }
            } else {
              parentDropdown.classList.add("open", "hs-dropdown-open");
              if (list) {
                list.style.display = "block";
                list.style.opacity = "1";
                list.style.visibility = "visible";
              }
            }
          }
        } else if (isDummy) {
          e.preventDefault();
        }
      });
    });

    const realNavLinks = document.querySelectorAll<HTMLAnchorElement>(
      ".nav-dropdown-list a:not(.hs-dropdown-toggle)",
    );
    realNavLinks.forEach((link) => {
      link.addEventListener("click", (e) => {
        const hasChildren = link.dataset.hasChildren === "true" || link.classList.contains("hs-dropdown-toggle");
        if (hasChildren && isMobile()) {
          e.preventDefault();
          return;
        }

        const href = link.getAttribute("href");
        if (!href || href === "#" || href === "javascript:void(0)") {
          e.preventDefault();
          return;
        }

        const dropdownLists = document.querySelectorAll<HTMLElement>(".nav-dropdown-list");
        dropdownLists.forEach((list) => {
          list.style.removeProperty("display");
          list.style.removeProperty("opacity");
          list.style.removeProperty("pointer-events");
        });
      });
    });
  }

  function closeAllDropdowns(): void {
    document.querySelectorAll<HTMLElement>(".hs-dropdown, .nav-dropdown").forEach((dropdown) => {
      dropdown.classList.remove("hs-dropdown-open", "open");
    });

    document.querySelectorAll<HTMLElement>(".hs-dropdown-menu, .nav-dropdown-list").forEach((menu) => {
      menu.classList.remove("hs-dropdown-open");
      menu.style.removeProperty("display");
      menu.style.removeProperty("opacity");
      menu.style.removeProperty("visibility");
      menu.style.removeProperty("pointer-events");
    });
  }

  let pagefindInstance: any = null;

  async function getPagefindInstance() {
    if (!pagefindInstance) {
      try {
        const pfPath = "/pagefind/pagefind.js";
        pagefindInstance = await import(/* @vite-ignore */ pfPath);
        await pagefindInstance.init();
      } catch (err) {
        console.warn("Pagefind JS module not initialized", err);
      }
    }
    return pagefindInstance;
  }

  function initInlineHeaderSearch(): void {
    const searchArea = document.getElementById("header-search-area");
    const searchBar = document.getElementById("header-search-bar");
    const searchTrigger = document.getElementById("header-search-trigger");
    const searchField = document.getElementById("header-search-field") as HTMLInputElement | null;
    const searchClear = document.getElementById("header-search-clear");
    const searchDropdown = document.getElementById("header-search-dropdown");
    const searchResults = document.getElementById("header-search-results");

    if (!searchArea || !searchBar || !searchTrigger || !searchField || !searchDropdown || !searchResults) return;

    if (searchArea.dataset.searchInitialized === "true") return;
    searchArea.dataset.searchInitialized = "true";

    function expandSearch(): void {
      searchBar?.classList.add("is-expanded");
      searchField?.classList.remove("opacity-0", "pointer-events-none");
      searchField?.classList.add("pointer-events-auto");
      searchClear?.classList.remove("hidden");
      setTimeout(() => searchField?.focus(), 50);
    }

    function collapseSearch(): void {
      searchBar?.classList.remove("is-expanded");
      searchField?.classList.add("opacity-0", "pointer-events-none");
      searchField?.classList.remove("pointer-events-auto");
      if (searchField) searchField.value = "";
      searchClear?.classList.add("hidden");
      searchDropdown?.classList.add("hidden");
      if (searchResults) searchResults.innerHTML = "";
    }

    searchBar.addEventListener("click", (e) => {
      const isExpanded = searchBar.classList.contains("is-expanded");
      if (!isExpanded) {
        e.preventDefault();
        expandSearch();
      }
    });

    searchTrigger.addEventListener("click", (e) => {
      e.preventDefault();
      e.stopPropagation();
      const isExpanded = searchBar.classList.contains("is-expanded");
      if (isExpanded) {
        if (!searchField.value.trim()) {
          collapseSearch();
        } else {
          searchField.focus();
        }
      } else {
        expandSearch();
      }
    });

    searchClear?.addEventListener("click", (e) => {
      e.preventDefault();
      e.stopPropagation();
      collapseSearch();
    });

    function escapeHTML(str: string): string {
      return str.replace(/[&<>"']/g, (c) => ({
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#039;"
      }[c] || c));
    }

    let debounceTimer: any = null;

    searchField.addEventListener("input", () => {
      clearTimeout(debounceTimer);
      const query = searchField.value.trim();

      if (!query) {
        searchDropdown.classList.add("hidden");
        if (searchResults) searchResults.innerHTML = "";
        return;
      }

      debounceTimer = setTimeout(async () => {
        searchDropdown.classList.remove("hidden");
        if (searchResults) {
          searchResults.innerHTML = `<div class="p-4 text-center text-xs text-slate-400 font-medium">Searching...</div>`;
        }

        try {
          const pf = await getPagefindInstance();
          if (!pf) return;

          const searchRes = await pf.search(query);
          const results = await Promise.all(searchRes.results.slice(0, 8).map((r: any) => r.data()));

          if (results.length === 0) {
            if (searchResults) {
              searchResults.innerHTML = `
                <div class="p-6 text-center">
                  <p class="text-sm font-semibold text-slate-700">No results found for "${escapeHTML(query)}"</p>
                  <p class="text-xs text-slate-400 mt-1">Try searching for GST, Tax, Audit, or Incorporation.</p>
                </div>
              `;
            }
            return;
          }

          let html = "";
          results.forEach((item: any) => {
            const title = item.meta?.title || "Page Result";
            const url = item.url;
            const excerpt = item.excerpt || "";

            html += `
              <a href="${escapeHTML(url)}" class="group block p-3.5 hover:bg-emerald-50/70 rounded-xl transition-colors border-b border-slate-100 last:border-b-0">
                <div class="font-semibold text-sm text-slate-800 group-hover:text-emerald-700 transition-colors">
                  ${escapeHTML(title)}
                </div>
                <div class="text-xs text-slate-500 mt-1 line-clamp-2 leading-relaxed">
                  ${excerpt}
                </div>
              </a>
            `;
          });

          if (searchResults) searchResults.innerHTML = html;
        } catch (e) {
          console.error("Pagefind search error", e);
        }
      }, 120);
    });

    document.addEventListener("click", (e) => {
      if (!searchArea?.contains(e.target as Node)) {
        if (!searchField.value.trim()) {
          collapseSearch();
        } else {
          searchDropdown.classList.add("hidden");
        }
      }
    });

    window.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        collapseSearch();
      }
    });

    searchDropdown.addEventListener("click", (e) => {
      const link = (e.target as HTMLElement).closest("a");
      if (link) {
        collapseSearch();
      }
    });
  }

  stickyHeader();
  initDropdownToggleAndClose();
  initInlineHeaderSearch();

  document.addEventListener("astro:page-load", () => {
    stickyHeader();
    initDropdownToggleAndClose();
    initInlineHeaderSearch();
  });

  window.addEventListener("pageshow", (event) => {
    if (event.persisted) {
      closeAllDropdowns();
    }
  });
</script>
