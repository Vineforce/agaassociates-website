---
import { getLocaleUrlCTM } from "@/lib/utils/i18nUtils.ts";
import { markdownify } from "@/lib/utils/textConverter";
import { splitProtectedText } from "@/lib/utils/splitProtectedText";
import SocialComponent from "@/components/widgets/Social.astro";
import social from "@/config/social.json";
import { useTranslations } from "@/lib/utils/i18nUtils.ts";
import Logo from "@/components/global/Logo.astro";
import { getFooterMenuGroups } from "@/lib/utils/menu";

const { footerSpaceTop = false, hasFooterDarkBackground = false } = Astro.props;

import config from ".astro/config.generated.json";
const t = await useTranslations(Astro.currentLocale as string);

let {
  copyright,
  footerDescription,
  contactInfo: { phone, email },
} = config.settings;

footerDescription = footerDescription || t("footer.description") || "";
const footerColumns = getFooterMenuGroups(t);

const copyrightText = splitProtectedText(
  copyright.text || t("footer.copyright") || "",
).join(" / ");

const socialOrder = ["facebook", "linkedin", "twitter", "instagram"];
const getSocialSortIndex = (label: string) => {
  const index = socialOrder.indexOf(label);

  return index === -1 ? socialOrder.length : index;
};

const footerSocials = social.main
  .filter((item) => item.enable)
  .sort(
    (first, second) =>
      getSocialSortIndex(first.label) - getSocialSortIndex(second.label),
  );
---

<footer
  class:list={[
    "py-0!",
    hasFooterDarkBackground ? "footer-dark" : "bg-theme-light",
    footerSpaceTop && "mt-16 lg:mt-20 xl:mt-24",
  ]}>
  <div class="container">
    <div class="section-spacing-vertical">
      <div class="grid gap-y-12 lg:grid-cols-12 lg:gap-x-8">
        <div class="lg:col-span-3">
          <Logo class="gap-1.5" />
          {
            footerDescription && (
              <p
                class="footer-description leading-body text-text-default mt-6 max-w-md text-base"
                set:html={markdownify(footerDescription)}
              />
            )
          }
          <div class="mt-4 flex flex-wrap gap-4">
            <div class="flex items-center gap-2 hover:underline">
              <svg
                width="20"
                height="20"
                viewBox="0 0 20 20"
                fill="none"
                xmlns="http://www.w3.org/2000/svg">
                <path
                  d="M16.625 17.5C14.8889 17.5 13.1701 17.125 11.4688 16.375C9.76736 15.625 8.22222 14.5556 6.83333 13.1667C5.44444 11.7778 4.375 10.2361 3.625 8.54167C2.875 6.84722 2.5 5.125 2.5 3.375V2.5H7.41667L8.1875 6.6875L5.8125 9.08333C6.11806 9.625 6.45833 10.1389 6.83333 10.625C7.20833 11.1111 7.61111 11.5625 8.04167 11.9792C8.44444 12.3819 8.88542 12.7674 9.36458 13.1354C9.84375 13.5035 10.3611 13.8472 10.9167 14.1667L13.3333 11.75L17.5 12.6042V17.5H16.625Z"
                  fill="currentColor">
                </path>
              </svg>
              <span set:html={markdownify(phone)} />
            </div>

            <div class="flex items-center gap-2 hover:underline">
              <svg
                width="20"
                height="20"
                viewBox="0 0 20 20"
                fill="none"
                xmlns="http://www.w3.org/2000/svg">
                <path
                  d="M1.66675 16.6667V3.33333H18.3334V16.6667H1.66675ZM10.0001 10.8333L16.6667 6.66666V4.99999L10.0001 9.16666L3.33341 4.99999V6.66666L10.0001 10.8333Z"
                  fill="currentColor">
                </path>
              </svg>

              <span set:html={markdownify(email)} />
            </div>
          </div>

          <SocialComponent
            size="md"
            buttonSize="md"
            class="footer-social mt-10 gap-2"
            linkType="follow"
            list={footerSocials}
          />
        </div>

        <nav
          aria-label={t("aria.footer")}
          class="grid gap-y-8 grid-cols-1 xs:grid-cols-2 sm:grid-cols-2 lg:grid-cols-4 lg:col-span-9 gap-x-6 sm:gap-x-8 xl:gap-x-10">
          {/* Column 1: Quick Links + Company stacked */}
          <div class="flex flex-col gap-8">
            {footerColumns.slice(0, 2).map(({ label, list }) => (
              <div>
                {label && (
                  <h2 class="footer-heading text-base sm:text-lg font-bold text-slate-900 mb-4 break-words sm:whitespace-nowrap" set:html={label} />
                )}
                <ul class="flex flex-col gap-2">
                  {list.map((item) => (
                    <li>
                      <a
                        class:list={[
                          "footer-link leading-snug text-slate-600 hover:text-[#0F5277] text-sm transition duration-200 block",
                          item.active && "active font-semibold text-slate-900",
                        ]}
                        href={getLocaleUrlCTM(item.url, Astro.currentLocale)}
                        set:html={item.name}
                      />
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>

          {/* Columns 2, 3, 4: Service & Consultancy columns */}
          {footerColumns.slice(2).map(({ label, list }) => (
            <div>
              {label && (
                <h2 class="footer-heading text-base sm:text-lg font-bold text-slate-900 mb-4 break-words sm:whitespace-nowrap" set:html={label} />
              )}
              <ul class="flex flex-col gap-2">
                {list.map((item) => (
                  <li>
                    <a
                      class:list={[
                        "footer-link leading-snug text-slate-600 hover:text-[#0F5277] text-sm transition duration-200 block",
                        item.active && "active font-semibold text-slate-900",
                      ]}
                      href={getLocaleUrlCTM(item.url, Astro.currentLocale)}
                      set:html={item.name}
                    />
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </nav>
      </div>
    </div>
    <div class="footer-bottom border-t border-slate-200/60 py-6 flex flex-col md:flex-row items-center justify-between gap-4 text-sm text-slate-600">
      {
        config.settings.copyright?.enable && (
          <p
            class="footer-copyright text-slate-600 text-sm font-medium"
            set:html={markdownify(copyrightText)}
          />
        )
      }
      <p class="text-sm text-slate-600 font-medium">
        Service Provided By <a href="https://www.vineforce.net/" target="_blank" rel="noopener noreferrer" class="underline hover:text-[#0F5277] font-semibold transition">Vineforce</a>
      </p>
    </div>
  </div>
</footer>
