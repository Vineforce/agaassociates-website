---
import { getLocaleUrlCTM, useTranslations } from "@/lib/utils/i18nUtils.ts";
import { markdownify } from "@/lib/utils/textConverter";

import Logo from "@/components/global/Logo.astro";
import { getFooterMenuGroups } from "@/lib/utils/menu";

const { footerSpaceTop = false, hasFooterDarkBackground = false } = Astro.props;

import config from ".astro/config.generated.json";
const t = await useTranslations(Astro.currentLocale as string);

let {
  copyright,
  footerDescription,
  contactInfo: { phone, email },
} = config.settings;

footerDescription = footerDescription || t("footer.description") || "";
const footerColumns = getFooterMenuGroups(t);


---

<footer
  class:list={[
    "py-0! bg-[#082738]",
    hasFooterDarkBackground && "footer-dark",
    footerSpaceTop && "mt-16 lg:mt-20 xl:mt-24",
  ]}>
  <div class="container">
    <div class="section-spacing pt-12 pb-10 lg:pb-12 xl:pb-14">
      <div class="grid gap-y-12 lg:grid-cols-12 lg:gap-x-8">
        <div class="lg:col-span-3">
          <Logo src="/images/footer-logo.png" class="gap-1.5 max-w-[220px] sm:max-w-[280px]" />
          {
            footerDescription && (
              <p
                class="footer-description leading-body text-white/80 mt-6 max-w-md text-sm"
                set:html={markdownify(footerDescription)}
              />
            )
          }
          <div class="mt-5 flex flex-col gap-3">
            <div class="flex items-center gap-2 text-white/90 hover:text-white hover:underline transition-colors duration-200 text-sm">
              <svg
                width="18"
                height="18"
                viewBox="0 0 20 20"
                fill="none"
                xmlns="http://www.w3.org/2000/svg">
                <path
                  d="M16.625 17.5C14.8889 17.5 13.1701 17.125 11.4688 16.375C9.76736 15.625 8.22222 14.5556 6.83333 13.1667C5.44444 11.7778 4.375 10.2361 3.625 8.54167C2.875 6.84722 2.5 5.125 2.5 3.375V2.5H7.41667L8.1875 6.6875L5.8125 9.08333C6.11806 9.625 6.45833 10.1389 6.83333 10.625C7.20833 11.1111 7.61111 11.5625 8.04167 11.9792C8.44444 12.3819 8.88542 12.7674 9.36458 13.1354C9.84375 13.5035 10.3611 13.8472 10.9167 14.1667L13.3333 11.75L17.5 12.6042V17.5H16.625Z"
                  fill="currentColor">
                </path>
              </svg>
              <span set:html={markdownify(phone)} />
            </div>

            <div class="flex items-center gap-2 text-white/90 hover:text-white hover:underline transition-colors duration-200 text-sm">
              <svg
                width="18"
                height="18"
                viewBox="0 0 20 20"
                fill="none"
                xmlns="http://www.w3.org/2000/svg">
                <path
                  d="M1.66675 16.6667V3.33333H18.3334V16.6667H1.66675ZM10.0001 10.8333L16.6667 6.66666V4.99999L10.0001 9.16666L3.33341 4.99999V6.66666L10.0001 10.8333Z"
                  fill="currentColor">
                </path>
              </svg>
              <span set:html={markdownify(email)} />
            </div>
          </div>
        </div>

        <nav
          aria-label={t("aria.footer")}
          class="grid gap-y-8 grid-cols-1 xs:grid-cols-2 sm:grid-cols-2 lg:grid-cols-4 lg:col-span-9 gap-x-6 sm:gap-x-8 xl:gap-x-10">
          {/* Column 1: Quick Links + Company stacked */}
          <div class="flex flex-col gap-8">
            {footerColumns.slice(0, 2).map(({ label, list }) => (
              <div>
                {label && (
                  <h2 class="footer-heading text-base font-bold text-white mb-4 break-words sm:whitespace-nowrap" set:html={label} />
                )}
                <ul class="flex flex-col gap-2">
                  {list.map((item) => (
                    <li>
                      <a
                        class:list={[
                          "footer-link leading-snug text-white/70 hover:text-white text-sm transition duration-200 block",
                          item.active && "active font-semibold text-white",
                        ]}
                        href={getLocaleUrlCTM(item.url, Astro.currentLocale)}
                        set:html={item.name}
                      />
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>

          {/* Columns 2, 3, 4: Service & Consultancy columns */}
          {footerColumns.slice(2).map(({ label, list }) => (
            <div>
              {label && (
                <h2 class="footer-heading text-base font-bold text-white mb-4 break-words sm:whitespace-nowrap" set:html={label} />
              )}
              <ul class="flex flex-col gap-2">
                {list.map((item) => (
                  <li>
                    <a
                      class:list={[
                        "footer-link leading-snug text-white/70 hover:text-white text-sm transition duration-200 block",
                        item.active && "active font-semibold text-white",
                      ]}
                      href={getLocaleUrlCTM(item.url, Astro.currentLocale)}
                      set:html={item.name}
                    />
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </nav>
      </div>
    </div>
  </div>
  <div class="footer-bottom bg-[#4CAF50] py-3 text-sm text-white">
    <div class="container flex flex-col md:flex-row items-center justify-between gap-4 px-4">
      {
        config.settings.copyright?.enable && (
          <span class="footer-copyright !text-white text-sm">
            Copyright © 2026{" "}
            <a
              href="/"
              class="text-white hover:underline cursor-pointer"
            >H A V N &amp; COMPANY</a>. All rights reserved. Last updated on Sept 17, 2026.
          </span>
        )
      }
      <p class="text-sm text-white font-normal">
        Service Provided By <a href="https://www.vineforce.net/" target="_blank" rel="noopener noreferrer" class="underline hover:text-white/80 font-normal transition">Vineforce</a>
      </p>
    </div>
  </div>
</footer>
