---
import Button from "@/components/Button.astro";
import { useTranslations } from "@/lib/utils/i18nUtils.ts";

interface Comment {
  author: string;
  date: string;
  content: string;
  website?: string;
}

interface Props {
  comments?: Comment[];
  commentCount?: number;
  class?: string;
}

const { comments = [], commentCount, class: className } = Astro.props;
const t = await useTranslations(Astro.currentLocale as string);
const count = commentCount !== undefined ? commentCount : comments.length;
const formattedCount = count.toLocaleString("en-US");
---

<div id="comments" class:list={["mt-12 pt-8 border-t border-slate-200/80 space-y-12", className]}>
  {/* Comments List Section */}
  {
    count > 0 && (
      <div class="space-y-6">
        <div>
          <h3 id="comment-count-heading" class="text-lg font-bold uppercase tracking-wider text-slate-900" data-count={count}>
            {formattedCount} {t("blog.comments")}
          </h3>
          <div class="w-12 h-[3px] bg-[#10b981] mt-2 rounded-full"></div>
        </div>
        <div id="comment-list-container" class="space-y-6 pt-2">
          {comments.map((comment) => (
            <div class="space-y-1">
              <div class="flex items-baseline gap-2.5">
                <span class="font-bold text-slate-900 text-[15px]">
                  {comment.website ? (
                    <a
                      href={comment.website}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="hover:text-emerald-600 transition-colors">
                      {comment.author}
                    </a>
                  ) : (
                    comment.author
                  )}
                </span>
                <span class="text-[#9ca3af] italic text-xs font-normal">
                  {comment.date}
                </span>
              </div>
              <div
                class="text-[#4b5563] text-[15px] leading-relaxed break-words"
                set:html={comment.content}
              />
            </div>
          ))}
        </div>
      </div>
    )
  }

  {/* LEAVE A REPLY Form Section */}
  <div id="respond" class="space-y-6 pt-4">
    <div>
      <h3 class="text-lg font-bold uppercase tracking-wider text-slate-900">
        {t("blog.leaveReply")}
      </h3>
      <div class="w-12 h-[3px] bg-[#10b981] mt-2 rounded-full"></div>
    </div>

    <form
      id="comment-form"
      class="space-y-5 max-w-3xl"
      aria-label={t("blog.leaveReply")}>
      <div class="space-y-5">
        <div>
          <input
            type="text"
            id="comment-author"
            name="author"
            required
            placeholder={t("blog.namePlaceholder")}
            class="w-full rounded-md border border-slate-200 bg-white px-4 py-3 text-base text-slate-800 placeholder:text-slate-400 transition-colors focus:border-[#10b981] focus:outline-none focus:ring-1 focus:ring-[#10b981]"
          />
        </div>

        <div>
          <input
            type="email"
            id="comment-email"
            name="email"
            required
            placeholder={t("blog.emailPlaceholder")}
            class="w-full rounded-md border border-slate-200 bg-white px-4 py-3 text-base text-slate-800 placeholder:text-slate-400 transition-colors focus:border-[#10b981] focus:outline-none focus:ring-1 focus:ring-[#10b981]"
          />
        </div>

        <div>
          <textarea
            id="comment-body"
            name="comment"
            rows="6"
            required
            placeholder={t("blog.commentPlaceholder")}
            class="w-full rounded-md border border-slate-200 bg-white px-4 py-3 text-base text-slate-800 placeholder:text-slate-400 transition-colors focus:border-[#10b981] focus:outline-none focus:ring-1 focus:ring-[#10b981] resize-y"
          ></textarea>
        </div>
      </div>

      <div>
        <Button
          tag="button"
          type="submit"
          variant="fill"
          label={t("blog.postComment")}
          class="bg-[#10b981] hover:bg-[#0e9f6e] text-white border-none font-semibold px-6 py-3 rounded-md shadow-sm transition-all duration-200"
        />
      </div>

      <div
        id="comment-success-msg"
        class="hidden rounded-md bg-emerald-50 p-4 text-sm text-emerald-800 border border-emerald-200">
        {t("blog.thankYouComment")}
      </div>
    </form>
  </div>
</div>

<script>
  const form = document.getElementById("comment-form") as HTMLFormElement | null;
  const successMsg = document.getElementById("comment-success-msg");
  const listContainer = document.getElementById("comment-list-container");
  const countHeading = document.getElementById("comment-count-heading");
  const storageKey = "aga_comments_" + window.location.pathname;

  function escapeHtml(str: string): string {
    const div = document.createElement("div");
    div.textContent = str;
    return div.innerHTML;
  }

  function renderNewCommentItem(author: string, date: string, content: string, prepend = true) {
    if (!listContainer) return;
    const item = document.createElement("div");
    item.className = "space-y-1 bg-emerald-50/60 p-4 rounded-lg border border-emerald-100 transition-all duration-300";
    item.innerHTML = `
      <div class="flex items-baseline gap-2.5">
        <span class="font-bold text-slate-900 text-[15px]">${escapeHtml(author)}</span>
        <span class="text-[#9ca3af] italic text-xs font-normal">${escapeHtml(date)}</span>
      </div>
      <div class="text-[#4b5563] text-[15px] leading-relaxed break-words">${escapeHtml(content)}</div>
    `;
    if (prepend) {
      listContainer.prepend(item);
      item.scrollIntoView({ behavior: "smooth", block: "nearest" });
    } else {
      listContainer.prepend(item);
    }
  }

  // Load saved local comments on page load
  try {
    const saved = localStorage.getItem(storageKey);
    if (saved && listContainer) {
      const parsed = JSON.parse(saved);
      if (Array.isArray(parsed)) {
        parsed.forEach((c) => {
          renderNewCommentItem(c.author, c.date, c.content, false);
        });
        if (countHeading && parsed.length > 0) {
          const currentCount = parseInt(countHeading.getAttribute("data-count") || "0", 10);
          const newTotal = currentCount + parsed.length;
          countHeading.textContent = `${newTotal.toLocaleString("en-US")} Comments`;
        }
      }
    }
  } catch (err) {
    console.warn("Could not load comments from localStorage", err);
  }

  if (form && successMsg) {
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const authorInput = document.getElementById("comment-author") as HTMLInputElement | null;
      const bodyInput = document.getElementById("comment-body") as HTMLTextAreaElement | null;

      const author = authorInput?.value.trim() || "Anonymous";
      const content = bodyInput?.value.trim() || "";
      const dateStr = new Date().toLocaleDateString("en-US", {
        month: "long",
        day: "numeric",
        year: "numeric",
      });

      if (!content) return;

      // Render new comment immediately on screen
      renderNewCommentItem(author, dateStr, content, true);

      // Increment displayed count
      if (countHeading) {
        const currentCount = parseInt(countHeading.getAttribute("data-count") || "0", 10);
        const newTotal = currentCount + 1;
        countHeading.setAttribute("data-count", String(newTotal));
        countHeading.textContent = `${newTotal.toLocaleString("en-US")} Comments`;
      }

      // Save to localStorage so it stays across page refreshes
      try {
        const existing = JSON.parse(localStorage.getItem(storageKey) || "[]");
        existing.unshift({ author, date: dateStr, content });
        localStorage.setItem(storageKey, JSON.stringify(existing));
      } catch (err) {
        console.warn("Could not save comment to localStorage", err);
      }

      // Show success message and reset form
      successMsg.classList.remove("hidden");
      form.reset();
      setTimeout(() => {
        successMsg.classList.add("hidden");
      }, 5000);
    });
  }
</script>
