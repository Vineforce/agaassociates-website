---
import { getCollectionCTM } from "@/lib/contentParser.astro";
import { getLocaleUrlCTM, useTranslations } from "@/lib/utils/i18nUtils.ts";
import type { CollectionEntry } from "astro:content";
import extractSlug from "@/lib/utils/extractSlug";
import { plainify } from "@/lib/utils/textConverter";

interface Props {
  prevBtnText?: string;
  collection?: string;
  nextBtnText?: string;
  currentPage?: CollectionEntry<"blog">;
  class?: string;
}

const t = await useTranslations(Astro.currentLocale as string);

let {
  prevBtnText = t("common.paginationPrevious"),
  nextBtnText = t("common.paginationNext"),
  collection,
  currentPage,
  class: className,
} = Astro.props;

let pages;
if (collection) {
  pages = await getCollectionCTM(
    collection as "blog",
    Astro.currentLocale,
  );
}

if (!pages) return;

const currentIndex = pages.findIndex(
  (item) => item.filePath === currentPage?.filePath,
);

// if (import.meta.env.DEV) console.log("Current page index:", currentIndex);

if (currentIndex === -1) {
  return;
}

const prevPage = pages[currentIndex - 1];
const nextPage = pages[currentIndex + 1];
---

<nav
  id="pagination"
  class:list={[
    "w-full bg-[#f8fafc] border border-slate-200/80 rounded-md p-4 sm:p-5 my-8 shadow-2xs",
    className,
  ]}
  aria-label={t("aria.pagination")}>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6 items-center">
    
    {/* Previous Post */}
    <div class="flex items-center gap-3 min-w-0">
      {
        prevPage && (
          <a
            href={getLocaleUrlCTM(
              extractSlug(prevPage).split("/").pop() || extractSlug(prevPage),
              Astro.currentLocale,
            )}
            class="group flex items-center gap-3 min-w-0 w-full">
            <span class="w-9 h-9 sm:w-10 sm:h-10 bg-[#61CE70] group-hover:bg-black text-white flex items-center justify-center rounded-xs shrink-0 transition-colors shadow-xs">
              <svg class="w-5 h-5 stroke-current fill-none stroke-[2.5]" viewBox="0 0 24 24">
                <path d="M15 18l-6-6 6-6"/>
              </svg>
            </span>
            <div class="min-w-0 flex-1">
              <span class="block text-[11px] font-extrabold tracking-wider uppercase text-[#61CE70] group-hover:text-[#10b981] transition-colors leading-tight mb-0.5">
                {prevBtnText}
              </span>
              <span
                class="block text-sm font-bold text-slate-900 group-hover:text-[#10b981] transition-colors truncate"
                set:html={plainify(prevPage.data.title)}
              />
            </div>
          </a>
        )
      }
    </div>

    {/* Next Post */}
    <div class="flex items-center justify-end gap-3 min-w-0 md:col-start-2">
      {
        nextPage && (
          <a
            href={getLocaleUrlCTM(
              extractSlug(nextPage).split("/").pop() || extractSlug(nextPage),
              Astro.currentLocale,
            )}
            class="group flex items-center justify-end gap-3 min-w-0 w-full text-right">
            <div class="min-w-0 flex-1 text-right">
              <span class="block text-[11px] font-extrabold tracking-wider uppercase text-[#61CE70] group-hover:text-[#10b981] transition-colors leading-tight mb-0.5">
                {nextBtnText}
              </span>
              <span
                class="block text-sm font-bold text-slate-900 group-hover:text-[#10b981] transition-colors truncate"
                set:html={plainify(nextPage.data.title)}
              />
            </div>
            <span class="w-9 h-9 sm:w-10 sm:h-10 bg-[#61CE70] group-hover:bg-black text-white flex items-center justify-center rounded-xs shrink-0 transition-colors shadow-xs">
              <svg class="w-5 h-5 stroke-current fill-none stroke-[2.5]" viewBox="0 0 24 24">
                <path d="M9 18l6-6-6-6"/>
              </svg>
            </span>
          </a>
        )
      }
    </div>

  </div>
</nav>
