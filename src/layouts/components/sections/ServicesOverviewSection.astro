---
import type { servicesOverviewSectionSchema } from "@/sections.schema";
import { getEntryCTM } from "@/lib/contentParser.astro";
import { getLocaleUrlCTM } from "@/lib/utils/i18nUtils.ts";
import DynamicIcon from "@/helpers/DynamicIcon.astro";
import type { z } from "astro/zod";

type ServicesOverviewSectionType = NonNullable<
  z.infer<typeof servicesOverviewSectionSchema>
>;

interface Props {
  content?: ServicesOverviewSectionType;
}

const { content: contentProps } = Astro.props;

const contentEntry = (
  await getEntryCTM(
    "sections",
    "services-overview-section",
    Astro.currentLocale,
  )
)?.data as ServicesOverviewSectionType | undefined;

const content = contentProps || contentEntry;

if (!content || content.enable === false) {
  return null;
}

const services = content.services || [];
const cta = content.cta;
const ctaUrl = cta?.buttonUrl
  ? getLocaleUrlCTM(cta.buttonUrl, Astro.currentLocale)
  : "#";
---

<section class="services-overview-section relative bg-gradient-to-b from-white via-slate-50/60 to-slate-100/50 py-12 md:py-16 overflow-hidden">
  {/* Decorative background watermark circles */}
  <div class="pointer-events-none absolute -left-20 top-10 size-72 rounded-full border border-[#61CE70]/10 bg-[#61CE70]/5 blur-3xl"></div>
  <div class="pointer-events-none absolute -right-20 bottom-10 size-80 rounded-full border border-[#61CE70]/10 bg-[#61CE70]/5 blur-3xl"></div>

  <div class="container relative z-10 mx-auto px-4 md:px-6">
    {/* Section Header */}
    <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-12">
      {content.title && (
        <h2
          class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight"
          set:html={content.title}
        />
      )}
    </div>

    {/* 6 Services Grid - Top-Left Icon + Title, No Bottom Arrow */}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 lg:gap-6">
      {
        services.map((item) => {
          const itemUrl = item.url
            ? getLocaleUrlCTM(item.url, Astro.currentLocale)
            : "#";

          return (
            <article class="group relative flex flex-col justify-start rounded-2xl bg-white p-5 sm:p-6 border border-slate-100 shadow-xs transition-all duration-300 hover:shadow-lg hover:-translate-y-1">
              <div class="flex items-center gap-3.5 mb-3.5">
                <div class="flex size-12 shrink-0 items-center justify-center rounded-2xl bg-[#EEFBEE] text-[#0F5277] transition-colors duration-300 group-hover:bg-[#61CE70] group-hover:text-white shadow-xs">
                  <DynamicIcon
                    name={item.icon || "Briefcase"}
                    inlineSvg={true}
                    class="size-6 stroke-[2]"
                  />
                </div>

                <h3 class="text-base sm:text-lg font-bold text-slate-900 leading-snug transition-colors group-hover:text-[#0F5277]">
                  {item.title}
                </h3>
              </div>

              <p class="text-xs sm:text-sm text-slate-500 leading-relaxed font-normal">
                {item.description}
              </p>

              {itemUrl && (
                <a
                  href={itemUrl}
                  class="absolute inset-0 z-10 size-full"
                  aria-label={item.title}
                />
              )}
            </article>
          );
        })
      }
    </div>

    {/* Bottom Call to Action Banner */}
    {
      cta?.enable && (
        <div class="mt-10 sm:mt-12 rounded-2xl bg-slate-50/80 border border-slate-200/80 p-5 sm:p-6 flex flex-col sm:flex-row items-center justify-between gap-4 shadow-xs">
          <div class="flex items-center gap-4 text-center sm:text-left">
            <div class="flex size-11 shrink-0 items-center justify-center rounded-full bg-[#0F5277] text-white shadow-sm">
              <DynamicIcon
                name={cta.icon || "Headphones"}
                inlineSvg={true}
                class="size-5 stroke-[2]"
              />
            </div>
            <div>
              <h4 class="text-base sm:text-lg font-bold text-slate-900">
                {cta.title}
              </h4>
              <p class="text-xs sm:text-sm text-slate-600 mt-0.5">
                {cta.subtitle}
              </p>
            </div>
          </div>

          <a
            href={ctaUrl}
            class="inline-flex items-center gap-2 rounded-full bg-[#0F5277] hover:bg-[#61CE70] px-6 py-3 text-sm font-semibold text-white shadow-sm transition-colors duration-300 hover:shadow-md shrink-0">
            <span>{cta.buttonLabel}</span>
            <DynamicIcon
              name="ArrowRight"
              inlineSvg={true}
              class="size-4 stroke-[2.5]"
            />
          </a>
        </div>
      )
    }
  </div>
</section>
