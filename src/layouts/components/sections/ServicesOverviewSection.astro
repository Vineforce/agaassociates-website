---
import type { servicesOverviewSectionSchema } from "@/sections.schema";
import { getEntryCTM } from "@/lib/contentParser.astro";
import { getLocaleUrlCTM } from "@/lib/utils/i18nUtils.ts";
import OptimizedImage from "@/components/utilities/OptimizedImage.astro";
import DynamicIcon from "@/helpers/DynamicIcon.astro";
import type { z } from "astro/zod";

type ServicesOverviewSectionType = NonNullable<
  z.infer<typeof servicesOverviewSectionSchema>
>;

interface Props {
  content?: ServicesOverviewSectionType;
}

const { content: contentProps } = Astro.props;

const contentEntry = (
  await getEntryCTM(
    "sections",
    "services-overview-section",
    Astro.currentLocale,
  )
)?.data as ServicesOverviewSectionType | undefined;

const content = contentProps || contentEntry;

if (!content || content.enable === false) {
  return null;
}

const services = (content.services || []) as Array<{
  title: string;
  image?: string;
  description: string;
  url?: string;
  icon?: string;
}>;

const cta = content.cta;
const ctaUrl = cta?.buttonUrl
  ? getLocaleUrlCTM(cta.buttonUrl, Astro.currentLocale)
  : "#";
---

<section class="services-overview-section relative bg-white py-12 lg:py-16 overflow-hidden">
  <div class="container relative z-10 mx-auto px-4 md:px-6">
    
    <!-- Section Header (Exact as screenshot: Title + Subtitle) -->
    <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-14">
      {content.title && (
        <h2
          class="text-3xl sm:text-4xl lg:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight mb-4"
          set:html={content.title}
        />
      )}

      {content.subtitle && (
        <p class="text-sm sm:text-base text-slate-600 leading-relaxed max-w-2xl mx-auto font-normal">
          {content.subtitle}
        </p>
      )}
    </div>

    <!-- 6 Services Grid Cards (Image top, Title, Description, READ MORE button) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      {
        services.map((item) => {
          const itemUrl = item.url ? getLocaleUrlCTM(item.url, Astro.currentLocale) : "#";

          return (
            <article class="group relative flex flex-col rounded-xl bg-white border border-slate-200/80 shadow-xs overflow-hidden transition-all duration-300 hover:shadow-xl hover:-translate-y-1">
              {item.image && (
                <a href={itemUrl} class="block relative aspect-[16/10] w-full overflow-hidden bg-slate-100">
                  <OptimizedImage
                    src={item.image}
                    alt={item.title || "Service"}
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  />
                </a>
              )}

              <div class="p-6 sm:p-7 flex flex-col flex-1 justify-between bg-white">
                <div>
                  <h3 class="text-lg sm:text-xl font-bold text-slate-900 mb-3 group-hover:text-[#0F5277] transition-colors leading-snug">
                    <a href={itemUrl}>
                      {item.title}
                    </a>
                  </h3>

                  <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-6 font-normal line-clamp-4">
                    {item.description}
                  </p>
                </div>

                <div>
                  <a
                    href={itemUrl}
                    class="inline-flex items-center gap-1.5 text-xs font-bold text-[#61CE70] hover:text-[#0F5277] uppercase tracking-wider transition-colors">
                    <span>READ MORE</span>
                    <svg class="size-3.5 stroke-[2.5]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                      <path d="m9 18 6-6-6-6" />
                    </svg>
                  </a>
                </div>
              </div>
            </article>
          );
        })
      }
    </div>

    <!-- Bottom Call to Action Banner -->
    {
      cta?.enable && (
        <div class="mt-12 sm:mt-16 rounded-2xl bg-slate-50/90 border border-slate-200/80 p-6 sm:p-8 flex flex-col sm:flex-row items-center justify-between gap-6 shadow-xs">
          <div class="flex items-center gap-4 text-center sm:text-left">
            <div class="flex size-12 shrink-0 items-center justify-center rounded-full bg-[#0F5277] text-white shadow-sm">
              <DynamicIcon
                name={cta.icon || "Headphones"}
                inlineSvg={true}
                class="size-6 stroke-[2]"
              />
            </div>
            <div>
              <h4 class="text-base sm:text-lg font-bold text-slate-900">
                {cta.title}
              </h4>
              <p class="text-xs sm:text-sm text-slate-600 mt-0.5">
                {cta.subtitle}
              </p>
            </div>
          </div>

          <a
            href={ctaUrl}
            class="inline-flex items-center gap-2 rounded-full bg-[#0F5277] hover:bg-[#61CE70] px-6 py-3 text-sm font-semibold text-white shadow-sm transition-colors duration-300 hover:shadow-md shrink-0">
            <span>{cta.buttonLabel}</span>
            <DynamicIcon
              name="ArrowRight"
              inlineSvg={true}
              class="size-4 stroke-[2.5]"
            />
          </a>
        </div>
      )
    }

  </div>
</section>
