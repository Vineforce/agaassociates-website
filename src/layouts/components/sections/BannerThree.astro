---
import Button from "@/components/Button.astro";

const slides = [
  {
    title: "Professional Chartered Accountancy Services",
    description:
      "Committed to delivering quality financial and advisory solutions with integrity and excellence",
    button: {
      enable: true,
      label: "About Us",
      url: "/about-us/",
      variant: "fill" as const,
    },
    secondaryButton: {
      enable: true,
      label: "Contact Us",
      url: "/contact/",
      variant: "outline" as const,
    },
    bgImage: "/images/banner/hero-slide-1.jpg",
  },
  {
    title: "Comprehensive Financial Expertise",
    description:
      "Offering a wide range of accounting and auditing services tailored to your business needs",
    button: {
      enable: true,
      label: "About Us",
      url: "/about-us/",
      variant: "fill" as const,
    },
    secondaryButton: {
      enable: true,
      label: "Contact Us",
      url: "/contact/",
      variant: "outline" as const,
    },
    bgImage: "/images/banner/hero-slide-2.jpg",
  },
  {
    title: "Ethical & Transparent Financial Practices",
    description:
      "Adhering strictly to ICAI professional guidelines, ensuring ethical conduct and complete transparency in all financial services.",
    button: {
      enable: true,
      label: "About Us",
      url: "/About/",
      variant: "fill" as const,
    },
    secondaryButton: {
      enable: true,
      label: "Contact Us",
      url: "/contact/",
      variant: "outline" as const,
    },
    bgImage: "/images/banner/hero-slide-3.jpg",
  },
];
---

<section class="banner-three-section relative overflow-hidden bg-slate-900 mt-0 pt-0 min-h-[480px] sm:min-h-[640px] md:min-h-[680px] flex items-center">
  <div class="hero-carousel-container relative w-full h-[480px] sm:h-[640px] md:h-[680px] flex items-center">
    {
      slides.map((slide, index) => (
        <div
          class:list={[
            "hero-slide absolute inset-0 flex items-center py-14 sm:py-20 lg:py-24",
            index === 0 ? "is-active" : "",
          ]}
          data-slide-index={index}>
          <div class="absolute inset-0 z-0">
            <img
              src={slide.bgImage}
              alt={slide.title}
              class="w-full h-full object-cover object-center"
            />
            <div class="absolute inset-0 bg-gradient-to-r from-white/95 via-white/80 sm:via-white/70 to-transparent max-w-full sm:max-w-2xl" />
          </div>

          <div class="container relative z-10 text-left">
            <div class="max-w-sm sm:max-w-xl lg:max-w-2xl">
              <h1 class="hero-slide-title text-2xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-[#0F5277] leading-tight mb-4 sm:mb-5">
                {slide.title}
              </h1>
              <p class="hero-slide-desc text-slate-800 sm:text-slate-700 text-sm sm:text-base lg:text-xl font-medium sm:font-normal mb-6 sm:mb-8 leading-relaxed">
                {slide.description}
              </p>
              <div class="hero-slide-btns flex flex-wrap items-center justify-start gap-3 sm:gap-4">
                {slide.button?.enable && <Button {...slide.button} />}
                {slide.secondaryButton?.enable && <Button {...slide.secondaryButton} class="hero-outline-btn" />}
              </div>
            </div>
          </div>
        </div>
      ))
    }

    <!-- Side Navigation Controls (< and >) - Hidden on mobile (< md) to prevent overlapping -->
    <button
      type="button"
      id="hero-prev-btn"
      class="absolute left-4 top-1/2 -translate-y-1/2 z-30 hidden md:flex size-11 items-center justify-center bg-black/60 text-white rounded transition hover:bg-black/80 cursor-pointer"
      aria-label="Previous Slide">
      <svg xmlns="http://www.w3.org/2000/svg" class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
    </button>
    <button
      type="button"
      id="hero-next-btn"
      class="absolute right-4 top-1/2 -translate-y-1/2 z-30 hidden md:flex size-11 items-center justify-center bg-black/60 text-white rounded transition hover:bg-black/80 cursor-pointer"
      aria-label="Next Slide">
      <svg xmlns="http://www.w3.org/2000/svg" class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
    </button>

    <!-- Carousel Pagination Dots -->
    <div class="absolute bottom-6 left-0 right-0 z-20 flex justify-center items-center gap-2">
      {
        slides.map((_, index) => (
          <button
            type="button"
            class:list={[
              "hero-dot h-2.5 rounded-full transition-all duration-300 cursor-pointer border border-black/20",
              index === 0 ? "bg-primary w-7" : "bg-black/30 w-2.5 hover:bg-black/60",
            ]}
            data-dot-index={index}
            aria-label={`Go to slide ${index + 1}`}
          />
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Slide visibility */
  .hero-slide {
    opacity: 0;
    z-index: 0;
    pointer-events: none;
    transition: opacity 0.7s ease-in-out;
  }
  .hero-slide.is-active {
    opacity: 1;
    z-index: 10;
    pointer-events: auto;
  }

  /* Entrance animation: slide up + fade in */
  @keyframes slideUpFade {
    from { opacity: 0; transform: translateY(28px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .hero-slide.is-active .hero-slide-title {
    animation: slideUpFade 0.65s ease-out 0.1s both;
  }
  .hero-slide.is-active .hero-slide-desc {
    animation: slideUpFade 0.65s ease-out 0.3s both;
  }
  .hero-slide.is-active .hero-slide-btns {
    animation: slideUpFade 0.65s ease-out 0.5s both;
  }

  /* Hero buttons sizing: balanced medium size */
  .banner-three-section .btn {
    padding: 0.625rem 1.5rem !important;
    font-size: 1rem !important;
    line-height: 1.5 !important;
  }

  /* Secondary button (Contact Us): Navy outline -> Turns Green on hover */
  .hero-outline-btn {
    color: #0F5277 !important;
    background: transparent !important;
    border: 2px solid #0F5277 !important;
    transform: none !important;
    transition: background-color 0.25s ease, border-color 0.25s ease, color 0.25s ease !important;
  }
  .hero-outline-btn:hover {
    background: #61CE70 !important;
    border-color: #61CE70 !important;
    color: #ffffff !important;
    transform: none !important;
  }

  /* Primary button (About Us / Our Services): Initial navy fill (#0F5277) -> Turns Green on hover (#61CE70) */
  .banner-three-section .btn-primary {
    background-color: #0F5277 !important;
    border: 2px solid #0F5277 !important;
    color: #ffffff !important;
    transform: none !important;
    transition: background-color 0.25s ease, border-color 0.25s ease, color 0.25s ease !important;
  }
  .banner-three-section .btn-primary:hover {
    background-color: #61CE70 !important;
    border-color: #61CE70 !important;
    color: #ffffff !important;
    transform: none !important;
  }
</style>

<script>
  function initHeroSlider() {
    const slides = document.querySelectorAll<HTMLElement>(".hero-slide");
    const dots = document.querySelectorAll<HTMLElement>(".hero-dot");
    const prevBtn = document.getElementById("hero-prev-btn");
    const nextBtn = document.getElementById("hero-next-btn");
    if (!slides.length) return;

    let currentIndex = 0;
    let timer: ReturnType<typeof setInterval> | null = null;

    function goToSlide(index: number) {
      slides[currentIndex].classList.remove("is-active");
      // Force reflow to restart CSS animations on new slide
      slides[index].classList.remove("is-active");
      void (slides[index] as HTMLElement).offsetWidth;
      slides[index].classList.add("is-active");

      dots.forEach((dot, i) => {
        if (i === index) {
          dot.classList.remove("bg-black/30", "w-2.5");
          dot.classList.add("bg-primary", "w-7");
        } else {
          dot.classList.remove("bg-primary", "w-7");
          dot.classList.add("bg-black/30", "w-2.5");
        }
      });

      currentIndex = index;
    }

    function startAutoPlay() {
      if (timer) clearInterval(timer);
      timer = setInterval(() => {
        goToSlide((currentIndex + 1) % slides.length);
      }, 5000);
    }

    dots.forEach((dot) => {
      dot.addEventListener("click", () => {
        goToSlide(parseInt(dot.getAttribute("data-dot-index") || "0", 10));
        startAutoPlay();
      });
    });

    prevBtn?.addEventListener("click", () => {
      goToSlide((currentIndex - 1 + slides.length) % slides.length);
      startAutoPlay();
    });

    nextBtn?.addEventListener("click", () => {
      goToSlide((currentIndex + 1) % slides.length);
      startAutoPlay();
    });

    startAutoPlay();
  }

  document.addEventListener("astro:page-load", initHeroSlider);
  document.addEventListener("DOMContentLoaded", initHeroSlider);
</script>
