---
import type { z } from "astro/zod";
import { markdownify } from "@/lib/utils/textConverter";
import type { teamSectionSchema } from "@/sections.schema";
import overrideObjects from "@/lib/utils/overrideObjects.ts";
import TeamCard from "@/layouts/components/cards/TeamCard.astro";
import { getCollectionCTM, getEntryCTM } from "@/lib/contentParser.astro";
import Marquee from "@/components/widgets/Marquee.astro";
import Button from "@/components/Button.astro";

// Type for this section data
type TeamInterface = NonNullable<z.infer<typeof teamSectionSchema>>;
type Props = {
  content?: Partial<TeamInterface>;
  hasSectionSpacing?: boolean;
  hasDarkAppearance?: boolean;
};

// Fetching the default content for this section
let defaultContent = (
  await getEntryCTM("sections", "team-section", Astro.currentLocale)
)?.data as TeamInterface | undefined;
const hasContentSource = Boolean(defaultContent || Astro.props.content);

// Merges custom content overrides with defaultContent fallbacks
let actualContent = overrideObjects(
  { ...(defaultContent || {}) },
  Astro.props.content || {},
) as TeamInterface;

// Extracting required values from 'content' object
const {
  enable = true,
  title,
  subtitle,
  button,
  limit,
  options: { layout = "grid", limit: optionsLimit = limit, marquee = {} } = {},
} = actualContent as any;

const rawMembers = await getCollectionCTM("team", Astro.currentLocale);
const members = (rawMembers || []).sort((a, b) => {
  const numA = (a.data as any).order ?? parseInt(a.id.match(/\d+/)?.[0] || "0", 10);
  const numB = (b.data as any).order ?? parseInt(b.id.match(/\d+/)?.[0] || "0", 10);
  return numA - numB;
});

// Limit the number of team members to be displayed
const slicedMembers =
  optionsLimit && members ? members.slice(0, optionsLimit as number) : members;

const { hasSectionSpacing = true, hasDarkAppearance = false } = Astro.props;
const carouselLayout = layout === "carousel";
const buttonProps = button && {
  ...button,
  hoverEffect: button.hoverEffect ?? "",
  variant: button.variant || (hasDarkAppearance ? "fill-white" : "fill"),
  class: `!px-4 !py-2 !text-sm ${button.class || ""}`.trim(),
};
const hasActionButton = Boolean(buttonProps?.enable && optionsLimit);
const defaultMarquee = {
  elementWidth: "20rem",
  elementWidthResponsive: "18rem",
  elementWidthAuto: false,
  pauseOnHover: true,
  reverse: "",
  duration: "40s",
  fullWidth: true,
};
const marqueeConfig = { ...defaultMarquee, ...marquee };
const marqueeMembers =
  slicedMembers.length > 3
    ? [...slicedMembers, ...slicedMembers]
    : Array.from({ length: 3 }, () => slicedMembers).flat();

// Robust category classification helper
function getMemberCategory(item: any): string {
  if (item.data?.category) return item.data.category;
  const profession = (item.data?.profession || "").toLowerCase();
  const order = item.data?.order ?? parseInt(item.id.match(/\d+/)?.[0] || "0", 10);

  if (profession.includes("senior") || order === 9 || order === 10) {
    return "SENIOR PROFESSIONALS";
  }
  if (profession.includes("assistant") || order >= 11) {
    return "ASSISTANT";
  }
  return "FIRM LEADERSHIP";
}

// Group sliced members by category in strict display order
const categoryGroups: { category: string; items: typeof slicedMembers }[] = [
  { category: "FIRM LEADERSHIP", items: [] },
  { category: "SENIOR PROFESSIONALS", items: [] },
  { category: "ASSISTANT", items: [] },
];

for (const item of slicedMembers) {
  const cat = getMemberCategory(item);
  let group = categoryGroups.find((g) => g.category === cat);
  if (!group) {
    group = { category: cat, items: [] };
    categoryGroups.push(group);
  }
  group.items.push(item);
}

const activeCategoryGroups = categoryGroups.filter((g) => g.items.length > 0);

if (!hasContentSource || !enable || !slicedMembers?.length) {
  return null;
}
---

<section
  class:list={[
    "py-12 md:py-16 bg-white",
    carouselLayout && "overflow-hidden",
    !hasSectionSpacing && "pt-0",
  ]}>
  <div
    class:list={[
      hasDarkAppearance && "bg-theme-dark section-spacing-vertical",
    ]}>
    <div class:list={[!carouselLayout && "container mx-auto px-4 md:px-6"]}>
      <div class="mx-auto space-y-12 md:space-y-16">
        {
          title && (
            <div
              data-scroll-reveal="blur-up"
              class:list={[
                "mx-auto text-center",
                carouselLayout ? "max-w-159" : "max-w-3xl",
              ]}>
              <h2
                class:list={[
                  "text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight leading-tight",
                  hasDarkAppearance ? "text-white" : "text-slate-900",
                ]}
                set:html={title}
              />
              {subtitle && (
                <p class="text-slate-600 text-sm sm:text-base font-medium mt-3">
                  {subtitle}
                </p>
              )}
            </div>
          )
        }
        {
          !title && (
            <h2
              class="sr-only"
              set:html={markdownify(defaultContent?.title || "Team")}
            />
          )
        }

        {
          slicedMembers && slicedMembers.length > 0 && !carouselLayout && (
            optionsLimit ? (
              <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
                {slicedMembers.map((item, index) => (
                  <div
                    data-scroll-reveal="fade-up"
                    data-scroll-reveal-delay={index * 30}>
                    <TeamCard content={item} />
                  </div>
                ))}
              </div>
            ) : (
              <div class="space-y-12 md:space-y-16">
                {activeCategoryGroups.map((group) => (
                  <div class="space-y-6">
                    <div>
                      <h3
                        class:list={[
                          "text-lg sm:text-xl font-extrabold tracking-wider uppercase",
                          hasDarkAppearance ? "text-white" : "text-slate-900",
                        ]}>
                        {group.category}
                      </h3>
                      <div class="w-12 h-1 bg-[#61CE70] rounded-full mt-2"></div>
                    </div>

                    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
                      {group.items.map((item, index) => (
                        <div
                          data-scroll-reveal="fade-up"
                          data-scroll-reveal-delay={index * 30}>
                          <TeamCard content={item} />
                        </div>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            )
          )
        }

        {
          slicedMembers && slicedMembers.length > 0 && carouselLayout && (
            <div class="overflow-hidden" data-scroll-reveal="blur-up">
              <Marquee
                elements={marqueeMembers.length}
                animationElements={slicedMembers.length}
                elementWidth={marqueeConfig.elementWidth ?? "20rem"}
                elementWidthResponsive={
                  marqueeConfig.elementWidthResponsive ?? "18rem"
                }
                elementWidthAuto={marqueeConfig.elementWidthAuto ?? false}
                pauseOnHover={marqueeConfig.pauseOnHover ?? true}
                reverse={marqueeConfig.reverse ?? ""}
                duration={marqueeConfig.duration ?? "40s"}
                fullWidth={marqueeConfig.fullWidth ?? true}
                class="items-stretch">
                {marqueeMembers.map((item) => (
                  <div class="min-w-(--marquee-element-width-responsive) px-3 md:min-w-(--marquee-element-width)">
                    <TeamCard content={item} />
                  </div>
                ))}
              </Marquee>
            </div>
          )
        }

        {
          buttonProps && hasActionButton && (
            <div
              data-scroll-reveal="fade-up"
              data-scroll-reveal-delay="160"
              class:list={[
                "flex justify-center",
                carouselLayout && "container",
              ]}>
              <Button {...buttonProps} />
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>
