---
import type { InferEntrySchema } from "astro:content";
import { markdownify } from "@/lib/utils/textConverter";
import { shortcodes } from "@/lib/shortcodes";
import OptimizedImage from "./utilities/OptimizedImage.astro";
import { render } from "astro:content";

const { data } = Astro.props.content;
const { title, image, profession, email } =
  data as InferEntrySchema<"team">;

const { Content } = await render(Astro.props.content);
---

<section class="pt-6 pb-16 lg:pt-10 lg:pb-24">
  <div class="container mx-auto px-4">
    <div
      class="team-single-layout mx-auto grid w-full grid-cols-1 items-center gap-y-8 lg:grid-cols-2">
      {
        image && (
          <div class="team-single-image relative overflow-hidden rounded-2xl max-w-sm mx-auto lg:mx-0 w-full h-[320px] sm:h-[360px] lg:h-[380px]">
            <OptimizedImage
              src={image}
              alt={title || "team member"}
              width={400}
              height={450}
              class="relative z-1 h-full w-full object-cover object-top rounded-2xl"
            />
          </div>
        )
      }

      <div class="team-single-content max-w-xl">
        <div class="space-y-2">
          {
            title && (
              <h1
                class="team-single-title md:text-h2 text-h3-sm"
                set:html={title}
              />
            )
          }
          {
            profession && (
              <p
                class="team-single-profession font-semibold"
                set:html={markdownify(profession)}
              />
            )
          }
        </div>

        <div class="team-single-bio prose-styles max-w-none">
          <Content components={shortcodes} />
        </div>

        <div class="team-single-contact space-y-3">
          {
            email && (
              <div class="team-single-contact-item">
                <svg
                  class="size-5"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true">
                  <path d="M3.5 5h17c.83 0 1.5.67 1.5 1.5v11c0 .83-.67 1.5-1.5 1.5h-17c-.83 0-1.5-.67-1.5-1.5v-11C2 5.67 2.67 5 3.5 5Zm.5 3.08v8.42c0 .28.22.5.5.5h15c.28 0 .5-.22.5-.5V8.08l-7.46 5.02c-.33.22-.76.22-1.09 0L4 8.08Zm.9-1.08 7.1 4.78L19.1 7H4.9Z" />
                </svg>
                <span set:html={markdownify(email)} />
              </div>
            )
          }
        </div>


      </div>
    </div>
  </div>
</section>

<style>
  .team-single-layout {
    max-width: 960px;
    gap: 36px;
  }

  .team-single-image {
    background: transparent;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .team-single-content {
    color: #0a165e;
  }

  .team-single-title {
    color: #0a165e;
  }

  .team-single-profession {
    color: #0F5277;
    font-size: 18px;
    line-height: 28px;
    font-weight: 600;
  }

  .team-single-bio {
    margin-top: 24px;
  }

  .team-single-bio,
  .team-single-bio p {
    font-weight: 600 !important;
    color: #475569 !important;
    font-size: 16px !important;
    line-height: 28px !important;
  }

  .team-single-contact {
    margin-top: 28px;
  }

  .team-single-contact-item {
    display: flex;
    align-items: center;
    gap: 10px;
    color: #0a165e;
    font-size: 16px;
    line-height: 30px;
  }

  @media (min-width: 1024px) {
    .team-single-layout {
      grid-template-columns: minmax(280px, 340px) minmax(0, 1fr);
      gap: 48px;
    }

    .team-single-image {
      min-height: auto;
    }
  }
</style>
