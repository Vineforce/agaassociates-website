---
import DynamicIcon from "@/helpers/DynamicIcon.astro";
import type { IconName } from "@/lib/iconNames";

interface Props {
  title: string;
  subtitle?: string;
  description: string;
  icon: IconName;
  url?: string;
  class?: string;
}

const { title, subtitle, description, icon, url, class: className = "" } = Astro.props;
---

<article class={`group relative flex flex-col rounded-2xl bg-white border border-slate-200/80 p-5 sm:p-6 shadow-xs hover:shadow-md hover:border-[#10B981]/50 hover:-translate-y-0.5 transition-all duration-300 ${className}`}>
  <!-- Top row: Title + Icon -->
  <div class="flex items-center justify-between w-full gap-3 mb-1.5">
    <h3 class="text-base sm:text-lg font-bold text-slate-900 leading-snug group-hover:text-[#0F5277] transition-colors pr-2">
      {title}
    </h3>
    <!-- Icon badge — top right -->
    <div class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-[#D1FAE5] text-[#059669] group-hover:bg-[#10B981] group-hover:text-white transition-all duration-300">
      <DynamicIcon name={icon} inlineSvg={true} class="size-5 stroke-[2]" />
    </div>
  </div>

  {
    subtitle && (
      <p class="text-xs font-semibold text-[#059669] mb-2.5">
        {subtitle}
      </p>
    )
  }

  <!-- Description -->
  <p class="text-xs sm:text-sm text-slate-500 leading-relaxed flex-1">
    {description}
  </p>

  {
    url && (
      <a
        href={url}
        class="mt-4 inline-flex items-center gap-1.5 text-xs font-bold text-[#10B981] hover:text-[#0F5277] uppercase tracking-wider transition-colors group/link">
        <span>Learn More</span>
        <svg
          class="size-3.5 stroke-[2.5] transition-transform duration-200 group-hover/link:translate-x-0.5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round">
          <path d="M5 12h14M12 5l7 7-7 7" />
        </svg>
      </a>
    )
  }
</article>
