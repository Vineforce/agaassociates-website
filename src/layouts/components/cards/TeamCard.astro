---
import type { CollectionEntry } from "astro:content";
import { markdownify, toSentenceCase } from "@/lib/utils/textConverter";
import { getLocaleUrlCTM, useTranslations } from "@/lib/utils/i18nUtils.ts";
import OptimizedImage from "@/components/utilities/OptimizedImage.astro";
import extractSlug from "@/lib/utils/extractSlug";

interface Props {
  content: CollectionEntry<"team">;
  class?: string;
}

const { content, class: className, ...rest } = Astro.props;
const { title, image, profession } = content.data;

const t = await useTranslations(Astro.currentLocale as string);
const slug = getLocaleUrlCTM(
  extractSlug(content),
  Astro.currentLocale,
  "our-teams",
);
---

{
  image && (
    <article
      data-cursor-label={t("common.viewDetails")}
      data-cursor-type="link"
      class:list={[
        "group relative flex flex-col items-center justify-center rounded-2xl bg-white p-6 sm:p-7 border border-slate-200/80 shadow-xs transition-all duration-300 hover:shadow-md hover:scale-[1.02] hover:-translate-y-1 text-center",
        className,
      ]}
      {...rest}>
      <div class="relative size-32 sm:size-36 shrink-0 overflow-hidden rounded-full border-4 border-slate-100 bg-white shadow-xs">
        <OptimizedImage
          src={image}
          alt={title}
          class="h-full w-full object-cover object-top"
        />
      </div>

      <div class="mt-4 flex flex-col items-center">
        {title && (
          <h3
            class="text-base sm:text-lg font-extrabold text-slate-900 leading-snug group-hover:text-[#0F5277] transition-colors"
            set:html={markdownify(title)}
          />
        )}
        {profession && (
          <p
            class="text-xs sm:text-sm font-medium text-slate-500 mt-1"
            set:html={markdownify(profession)}
          />
        )}
      </div>

      <a
        title={toSentenceCase(t("common.learnMoreAbout") + " " + title)}
        class="absolute inset-0 z-20"
        href={slug}
        aria-label={title}
      />
    </article>
  )
}
